<?xml version="1.0" ?>
<!--
  UR10e + Robotiq 85 Gripper — Standalone URDF for PyBullet

  Generated from:
    - https://github.com/ros-industrial/universal_robot (noetic-devel)
    - https://github.com/cambel/robotiq (robotiq_85_gripper)

  UR10e kinematics: config/ur10e/default_kinematics.yaml
  UR10e joints:     config/ur10e/joint_limits.yaml
  UR10e physical:   config/ur10e/physical_parameters.yaml

  Joint limits (radians):
    shoulder_pan:  [-6.2832, 6.2832]  (±360°)
    shoulder_lift: [-6.2832, 6.2832]  (±360°)
    elbow:         [-3.1416, 3.1416]  (±180°)
    wrist_1:       [-6.2832, 6.2832]  (±360°)
    wrist_2:       [-6.2832, 6.2832]  (±360°)
    wrist_3:       [-6.2832, 6.2832]  (±360°)
-->
<robot name="ur10e_robotiq85">

  <!-- ============================================================ -->
  <!--  UR10e  BASE                                                  -->
  <!-- ============================================================ -->
  <link name="base_link">
    <inertial>
      <mass value="0.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>

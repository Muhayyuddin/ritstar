\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Per-iteration pipeline of RIT*. (a)\nobreakspace  {}A batch of samples is drawn from the Riemannian informed set $\mathcal  {I}_R$, which concentrates samples where improvements are possible. (b)\nobreakspace  {}Neighbors are found within ellipsoidal Riemannian radius $r_n^R$ --- the ellipse stretches along inexpensive directions. (c)\nobreakspace  {}Candidate parent edges are checked via a 3-level cascade: L1 (midpoint) rejects most, L2 (Simpson) filters further, and only L3 (Gauss--Legendre) uses full integration. (d)\nobreakspace  {}The new node can provide cheaper paths to existing nodes; their parent edges are rewired (old edge removed, new edge established). (e)\nobreakspace  {}Collision points from failed edge checks (red crosses) are fed to CARM, which builds a density-based cost field $s(x) = 1 + \alpha \hat  {f}(x)$ that inflates traversal cost near obstacles. (f)\nobreakspace  {}The informed set shrinks as $c_{\mathrm  {best}}$ improves; nodes that cannot contribute to better paths are pruned.\relax }}{7}{figure.caption.6}\protected@file@percent }
\newlabel{fig:pipeline}{{6}{7}{Per-iteration pipeline of RIT*. (a)~A batch of samples is drawn from the Riemannian informed set $\mathcal {I}_R$, which concentrates samples where improvements are possible. (b)~Neighbors are found within ellipsoidal Riemannian radius $r_n^R$ --- the ellipse stretches along inexpensive directions. (c)~Candidate parent edges are checked via a 3-level cascade: L1 (midpoint) rejects most, L2 (Simpson) filters further, and only L3 (Gauss--Legendre) uses full integration. (d)~The new node can provide cheaper paths to existing nodes; their parent edges are rewired (old edge removed, new edge established). (e)~Collision points from failed edge checks (red crosses) are fed to CARM, which builds a density-based cost field $s(x) = 1 + \alpha \hat {f}(x)$ that inflates traversal cost near obstacles. (f)~The informed set shrinks as $c_{\mathrm {best}}$ improves; nodes that cannot contribute to better paths are pruned.\relax }{figure.caption.6}{}}
\newlabel{fig:pipeline@cref}{{[figure][6][]6}{[1][3][]7}}
\newlabel{fig:compact_pipeline}{{6}{7}{Per-iteration pipeline of RIT*. (a)~A batch of samples is drawn from the Riemannian informed set $\mathcal {I}_R$, which concentrates samples where improvements are possible. (b)~Neighbors are found within ellipsoidal Riemannian radius $r_n^R$ --- the ellipse stretches along inexpensive directions. (c)~Candidate parent edges are checked via a 3-level cascade: L1 (midpoint) rejects most, L2 (Simpson) filters further, and only L3 (Gauss--Legendre) uses full integration. (d)~The new node can provide cheaper paths to existing nodes; their parent edges are rewired (old edge removed, new edge established). (e)~Collision points from failed edge checks (red crosses) are fed to CARM, which builds a density-based cost field $s(x) = 1 + \alpha \hat {f}(x)$ that inflates traversal cost near obstacles. (f)~The informed set shrinks as $c_{\mathrm {best}}$ improves; nodes that cannot contribute to better paths are pruned.\relax }{figure.caption.6}{}}
\newlabel{fig:compact_pipeline@cref}{{[figure][6][]6}{[1][3][]7}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Tree rewiring step. (a)\nobreakspace  {}Before rewiring: node\nobreakspace  {}$D$ is connected to parent\nobreakspace  {}$B$ with Riemannian edge cost 0.42. (b)\nobreakspace  {}Cost comparison: the alternative parent\nobreakspace  {}$C$ offers a cheaper connection ($g(C) + c_R(C,D) = 0.35$). (c)\nobreakspace  {}After rewiring: $D$ is reconnected to\nobreakspace  {}$C$, reducing the cost-to-come for all descendants.\relax }}{8}{figure.caption.7}\protected@file@percent }
\newlabel{fig:rewiring}{{7}{8}{Tree rewiring step. (a)~Before rewiring: node~$D$ is connected to parent~$B$ with Riemannian edge cost 0.42. (b)~Cost comparison: the alternative parent~$C$ offers a cheaper connection ($g(C) + c_R(C,D) = 0.35$). (c)~After rewiring: $D$ is reconnected to~$C$, reducing the cost-to-come for all descendants.\relax }{figure.caption.7}{}}
\newlabel{fig:rewiring@cref}{{[figure][7][]7}{[1][4][]8}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Whitened coordinate sampling. (a)\nobreakspace  {}In the original space, $I_R$ is a non-axis-aligned ellipsoid (hard to sample from directly). (b)\nobreakspace  {}The whitening transform $\tilde  {x} = G^{1/2} x$ maps $I_R$ to a standard prolate hyperspheroid. (c)\nobreakspace  {}Uniform samples in whitened space are mapped back via $G^{-1/2}$, yielding uniform coverage of $I_R$ in the Riemannian volume measure.\relax }}{8}{figure.caption.8}\protected@file@percent }
\newlabel{fig:whitening}{{8}{8}{Whitened coordinate sampling. (a)~In the original space, $I_R$ is a non-axis-aligned ellipsoid (hard to sample from directly). (b)~The whitening transform $\tilde {x} = G^{1/2} x$ maps $I_R$ to a standard prolate hyperspheroid. (c)~Uniform samples in whitened space are mapped back via $G^{-1/2}$, yielding uniform coverage of $I_R$ in the Riemannian volume measure.\relax }{figure.caption.8}{}}
\newlabel{fig:whitening@cref}{{[figure][8][]8}{[1][4][]8}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Cascading lazy edge evaluation. Edge cost is estimated at three levels of increasing accuracy: L1 (midpoint), L2 (Simpson's 3-point), L3 (Gauss--Legendre 10-point). Cheap checks prune unpromising edges before expensive evaluations.\relax }}{8}{figure.caption.9}\protected@file@percent }
\newlabel{fig:edge_eval}{{9}{8}{Cascading lazy edge evaluation. Edge cost is estimated at three levels of increasing accuracy: L1 (midpoint), L2 (Simpson's 3-point), L3 (Gauss--Legendre 10-point). Cheap checks prune unpromising edges before expensive evaluations.\relax }{figure.caption.9}{}}
\newlabel{fig:edge_eval@cref}{{[figure][9][]9}{[1][4][]8}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Connection radius comparison for $\kappa =10$, $n=1000$. The Riemannian radius (blue) is smaller than the Euclidean radius (red) because $\mu _{\!R}(I_R) < \mu (I_E)$, yielding fewer edges per vertex and faster per-iteration computation.\relax }}{8}{figure.caption.10}\protected@file@percent }
\newlabel{fig:connection_radius}{{10}{8}{Connection radius comparison for $\kappa =10$, $n=1000$. The Riemannian radius (blue) is smaller than the Euclidean radius (red) because $\muR (I_R) < \mu (I_E)$, yielding fewer edges per vertex and faster per-iteration computation.\relax }{figure.caption.10}{}}
\newlabel{fig:connection_radius@cref}{{[figure][10][]10}{[1][5][]8}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces CARM feedback loop. (a)\nobreakspace  {}Collision points (red crosses) are collected during edge evaluation; they cluster near obstacle boundaries. (b)\nobreakspace  {}A Gaussian kernel density estimate builds the adaptive cost field $s(x) = 1 + \alpha \,\hat  {f}(x)$, inflating traversal cost where collisions are dense. (c)\nobreakspace  {}The updated Riemannian metric tightens the informed set $\mathcal  {I}_R$ and steers sampling away from obstacles, yielding a shorter, safer path. The cycle repeats every $\Delta = 15$ iterations.\relax }}{9}{figure.caption.12}\protected@file@percent }
\newlabel{fig:carm_pipeline_compact}{{11}{9}{CARM feedback loop. (a)~Collision points (red crosses) are collected during edge evaluation; they cluster near obstacle boundaries. (b)~A Gaussian kernel density estimate builds the adaptive cost field $s(x) = 1 + \alpha \,\hat {f}(x)$, inflating traversal cost where collisions are dense. (c)~The updated Riemannian metric tightens the informed set $\mathcal {I}_R$ and steers sampling away from obstacles, yielding a shorter, safer path. The cycle repeats every $\Delta = 15$ iterations.\relax }{figure.caption.12}{}}
\newlabel{fig:carm_pipeline_compact@cref}{{[figure][11][]11}{[1][5][]9}}
\@writefile{loa}{\contentsline {algocf}{\numberline {1}{\ignorespaces RIT* planner\relax }}{9}{algocf.1}\protected@file@percent }
\newlabel{alg:ritstar}{{1}{9}{Connection Radius}{algocf.1}{}}
\newlabel{alg:ritstar@cref}{{[algorithm][1][]1}{[1][5][]9}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Convergence comparison with all paths evaluated under the oracle metric. RIT* (oracle) converges fastest; CARM (red) achieves lower oracle-metric cost than both Euclidean baselines, indicating that the learned metric steers sampling toward better paths.\relax }}{9}{figure.caption.13}\protected@file@percent }
\newlabel{fig:carm_convergence}{{12}{9}{Convergence comparison with all paths evaluated under the oracle metric. RIT* (oracle) converges fastest; CARM (red) achieves lower oracle-metric cost than both Euclidean baselines, indicating that the learned metric steers sampling toward better paths.\relax }{figure.caption.13}{}}
\newlabel{fig:carm_convergence@cref}{{[figure][12][]12}{[1][6][]9}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Collision-Adaptive Riemannian Metric (CARM) on the 2-D Obstacle environment. (a)\nobreakspace  {}Oracle metric field $\sqrt  {\qopname  \relax m{det}G(x)}$: high cost near obstacles. (b)\nobreakspace  {}CARM-learned scale $s(x)$ after 100 iterations ($\sim $400 collision points): the learned field concentrates near obstacle boundaries, approximating the oracle structure. (c)\nobreakspace  {}Resulting CARM tree and path.\relax }}{10}{figure.caption.14}\protected@file@percent }
\newlabel{fig:carm_metric_field}{{13}{10}{Collision-Adaptive Riemannian Metric (CARM) on the 2-D Obstacle environment. (a)~Oracle metric field $\sqrt {\det G(x)}$: high cost near obstacles. (b)~CARM-learned scale $s(x)$ after 100 iterations ($\sim $400 collision points): the learned field concentrates near obstacle boundaries, approximating the oracle structure. (c)~Resulting CARM tree and path.\relax }{figure.caption.14}{}}
\newlabel{fig:carm_metric_field@cref}{{[figure][13][]13}{[1][6][]10}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces CARM metric evolution over planning iterations. As more collision points are accumulated, the learned cost field progressively refines, leading to tighter informed sets and better sampling allocation.\relax }}{10}{figure.caption.15}\protected@file@percent }
\newlabel{fig:carm_evolution}{{14}{10}{CARM metric evolution over planning iterations. As more collision points are accumulated, the learned cost field progressively refines, leading to tighter informed sets and better sampling allocation.\relax }{figure.caption.15}{}}
\newlabel{fig:carm_evolution@cref}{{[figure][14][]14}{[1][6][]10}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces CARM directs samples away from obstacles. (a)\nobreakspace  {}Euclidean planner: 2746\nobreakspace  {}vertices, 824 in high-cost regions. (b)\nobreakspace  {}CARM planner: 1575\nobreakspace  {}vertices with 54\% fewer samples in high-cost regions and a 22.3\% oracle-cost improvement, demonstrating that the learned metric effectively steers sampling toward low-cost free space.\relax }}{11}{figure.caption.16}\protected@file@percent }
\newlabel{fig:carm_wasted}{{15}{11}{CARM directs samples away from obstacles. (a)~Euclidean planner: 2746~vertices, 824 in high-cost regions. (b)~CARM planner: 1575~vertices with 54\% fewer samples in high-cost regions and a 22.3\% oracle-cost improvement, demonstrating that the learned metric effectively steers sampling toward low-cost free space.\relax }{figure.caption.16}{}}
\newlabel{fig:carm_wasted@cref}{{[figure][15][]15}{[1][6][]11}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces CARM approximates the oracle metric near obstacles without a\nobreakspace  {}priori knowledge. (a)\nobreakspace  {}Oracle metric field $\sqrt  {\qopname  \relax m{det}G_{\mathrm  {oracle}}(x)}$. (b)\nobreakspace  {}CARM-learned scale $s(x)$ from 471\nobreakspace  {}collision points. (c)\nobreakspace  {}Pearson correlation $r = 0.935$ between learned and oracle values, confirming that CARM captures the essential cost structure from collision feedback alone.\relax }}{11}{figure.caption.17}\protected@file@percent }
\newlabel{fig:carm_correlation}{{16}{11}{CARM approximates the oracle metric near obstacles without a~priori knowledge. (a)~Oracle metric field $\sqrt {\det G_{\mathrm {oracle}}(x)}$. (b)~CARM-learned scale $s(x)$ from 471~collision points. (c)~Pearson correlation $r = 0.935$ between learned and oracle values, confirming that CARM captures the essential cost structure from collision feedback alone.\relax }{figure.caption.17}{}}
\newlabel{fig:carm_correlation@cref}{{[figure][16][]16}{[1][6][]11}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Tree growth sequence in 2-D. (a)\nobreakspace  {}Early exploration: samples spread across the Riemannian informed set; the tree reaches toward the goal. (b)\nobreakspace  {}First path found: $c_{\mathrm  {best}}$ is set and the informed set begins to shrink. (c)\nobreakspace  {}Refinement: rewiring and tighter sampling improve the path; CARM inflates cost near obstacles (warm shading). (d)\nobreakspace  {}Convergence: the tree is dense in the narrow informed set and the path approaches the true optimum.\relax }}{12}{figure.caption.18}\protected@file@percent }
\newlabel{fig:tree_growth_compact}{{17}{12}{Tree growth sequence in 2-D. (a)~Early exploration: samples spread across the Riemannian informed set; the tree reaches toward the goal. (b)~First path found: $c_{\mathrm {best}}$ is set and the informed set begins to shrink. (c)~Refinement: rewiring and tighter sampling improve the path; CARM inflates cost near obstacles (warm shading). (d)~Convergence: the tree is dense in the narrow informed set and the path approaches the true optimum.\relax }{figure.caption.18}{}}
\newlabel{fig:tree_growth_compact@cref}{{[figure][17][]17}{[1][6][]12}}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces The Riemannian informed set shrinks over batches as $c_{\mathrm  {best}}$ decreases. At $t=0$, sampling covers the entire space. As better paths are found, the informed set contracts, focusing computational effort on the most promising region.\relax }}{12}{figure.caption.19}\protected@file@percent }
\newlabel{fig:batch_shrinking}{{18}{12}{The Riemannian informed set shrinks over batches as $c_{\mathrm {best}}$ decreases. At $t=0$, sampling covers the entire space. As better paths are found, the informed set contracts, focusing computational effort on the most promising region.\relax }{figure.caption.19}{}}
\newlabel{fig:batch_shrinking@cref}{{[figure][18][]18}{[1][6][]12}}
\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces Mean final path cost over 5 Monte Carlo trials (lower is better). \textbf  {Bold}: best per environment. All planners achieve 100\% success rate.\relax }}{12}{table.caption.21}\protected@file@percent }
\newlabel{tab:cost}{{I}{12}{Mean final path cost over 5 Monte Carlo trials (lower is better). \textbf {Bold}: best per environment. All planners achieve 100\% success rate.\relax }{table.caption.21}{}}

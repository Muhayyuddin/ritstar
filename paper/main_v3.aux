\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces CARM feedback loop. \textbf  {(a)}\nobreakspace  {}Collision points (red) cluster near obstacle boundaries during edge evaluation. \textbf  {(b)}\nobreakspace  {}KDE builds the adaptive cost field $s(x) = 1 + \alpha \,\hat  {f}(x)$, inflating traversal cost where collisions are dense. \textbf  {(c)}\nobreakspace  {}Updated metric tightens $I_{\!R}$ and steers sampling away from obstacles. The cycle repeats every $\Delta = 15$ iterations.\relax }}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:carm_pipeline}{{6}{7}{CARM feedback loop. \textbf {(a)}~Collision points (red) cluster near obstacle boundaries during edge evaluation. \textbf {(b)}~KDE builds the adaptive cost field $s(x) = 1 + \alpha \,\hat {f}(x)$, inflating traversal cost where collisions are dense. \textbf {(c)}~Updated metric tightens $\IR $ and steers sampling away from obstacles. The cycle repeats every $\Delta = 15$ iterations.\relax }{figure.caption.8}{}}
\newlabel{fig:carm_pipeline@cref}{{[figure][6][]6}{[1][6][]7}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces CARM metric evolution over planning iterations. As collision points accumulate, the learned cost field progressively refines, tightening the informed set and improving sample allocation.\relax }}{7}{figure.caption.9}\protected@file@percent }
\newlabel{fig:carm_evolution}{{7}{7}{CARM metric evolution over planning iterations. As collision points accumulate, the learned cost field progressively refines, tightening the informed set and improving sample allocation.\relax }{figure.caption.9}{}}

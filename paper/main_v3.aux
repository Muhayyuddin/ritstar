\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Nearest-neighbour search. \textbf  {Left:} The Euclidean ball (circle) treats all directions equally, missing cheap neighbours along low-cost directions. \textbf  {Right:} The Riemannian ball (ellipse) stretches along cheap directions and compresses along expensive ones, connecting to the most cost-effective neighbours.\relax }}{5}{figure.caption.5}\protected@file@percent }
\newlabel{fig:nn_concept}{{4}{5}{Nearest-neighbour search. \textbf {Left:} The Euclidean ball (circle) treats all directions equally, missing cheap neighbours along low-cost directions. \textbf {Right:} The Riemannian ball (ellipse) stretches along cheap directions and compresses along expensive ones, connecting to the most cost-effective neighbours.\relax }{figure.caption.5}{}}
\newlabel{fig:nn_concept@cref}{{[figure][4][]4}{[1][4][]5}}
\newlabel{eq:simpson}{{7}{5}{Cascading Edge Evaluation}{equation.3.7}{}}
\newlabel{eq:simpson@cref}{{[equation][7][]7}{[1][5][]5}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Cascading edge evaluation. \textbf  {L1}: a single midpoint metric evaluation rejects ${\sim }80\%$ of candidate edges. \textbf  {L2}: Simpson's 3-point rule filters ${\sim }75\%$ of survivors. \textbf  {L3}: full 10-point Gauss--Legendre quadrature plus collision checking is applied only to the ${\sim }5\%$ of edges that survive both filters.\relax }}{5}{figure.caption.6}\protected@file@percent }
\newlabel{fig:cascade_concept}{{5}{5}{Cascading edge evaluation. \textbf {L1}: a single midpoint metric evaluation rejects ${\sim }80\%$ of candidate edges. \textbf {L2}: Simpson's 3-point rule filters ${\sim }75\%$ of survivors. \textbf {L3}: full 10-point Gauss--Legendre quadrature plus collision checking is applied only to the ${\sim }5\%$ of edges that survive both filters.\relax }{figure.caption.6}{}}
\newlabel{fig:cascade_concept@cref}{{[figure][5][]5}{[1][5][]5}}

\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Cascading edge evaluation. \textbf  {L1}: a single midpoint metric evaluation rejects ${\sim }80\%$ of candidate edges. \textbf  {L2}: Simpson's 3-point rule filters ${\sim }75\%$ of survivors. \textbf  {L3}: full 10-point Gauss--Legendre quadrature plus collision checking is applied only to the ${\sim }5\%$ of edges that survive both filters.\relax }}{6}{figure.caption.10}\protected@file@percent }
\newlabel{fig:cascade_concept}{{5}{6}{Cascading edge evaluation. \textbf {L1}: a single midpoint metric evaluation rejects ${\sim }80\%$ of candidate edges. \textbf {L2}: Simpson's 3-point rule filters ${\sim }75\%$ of survivors. \textbf {L3}: full 10-point Gauss--Legendre quadrature plus collision checking is applied only to the ${\sim }5\%$ of edges that survive both filters.\relax }{figure.caption.10}{}}
\newlabel{fig:cascade_concept@cref}{{[figure][5][]5}{[1][6][]6}}

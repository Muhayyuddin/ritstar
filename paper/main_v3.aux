\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Per-iteration pipeline of RIT*. \textbf  {(a)}\nobreakspace  {}Samples drawn from the Riemannian informed set\nobreakspace  {}$I_{\!R}$. \textbf  {(b)}\nobreakspace  {}Neighbours identified within ellipsoidal Riemannian radius\nobreakspace  {}$r_n^R$. \textbf  {(c)}\nobreakspace  {}Three-level cascade filters candidate edges (L1$\to $L2$\to $L3). \textbf  {(d)}\nobreakspace  {}Rewiring via cheaper Riemannian connections. \textbf  {(e)}\nobreakspace  {}CARM collects collision points and rebuilds the metric field. \textbf  {(f)}\nobreakspace  {}Pruning shrinks the informed set as $c_{\mathrm  {best}}$ decreases.\relax }}{4}{figure.caption.6}\protected@file@percent }
\newlabel{fig:pipeline}{{2}{4}{Per-iteration pipeline of RIT*. \textbf {(a)}~Samples drawn from the Riemannian informed set~$\IR $. \textbf {(b)}~Neighbours identified within ellipsoidal Riemannian radius~$r_n^R$. \textbf {(c)}~Three-level cascade filters candidate edges (L1$\to $L2$\to $L3). \textbf {(d)}~Rewiring via cheaper Riemannian connections. \textbf {(e)}~CARM collects collision points and rebuilds the metric field. \textbf {(f)}~Pruning shrinks the informed set as $c_{\mathrm {best}}$ decreases.\relax }{figure.caption.6}{}}
\newlabel{fig:pipeline@cref}{{[figure][2][]2}{[1][3][]4}}

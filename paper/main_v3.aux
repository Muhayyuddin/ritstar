\newlabel{fig:sampling_concept}{{3}{4}{Euclidean vs.\ Riemannian informed sets. The Euclidean set~$\IE $ (orange dashed) includes high-cost regions near obstacles, wasting samples (orange dots). The Riemannian set~$\IR $ (teal) is provably smaller, concentrating samples where path improvement is possible (teal dots).\relax }{figure.caption.4}{}}
\newlabel{fig:sampling_concept@cref}{{[figure][3][]3}{[1][4][]4}}

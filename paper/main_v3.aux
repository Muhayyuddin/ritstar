\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Euclidean vs.\ Riemannian informed sets. The Euclidean set\nobreakspace  {}$I_{\!E}$ (orange dashed) includes high-cost regions near obstacles, wasting samples (orange dots). The Riemannian set\nobreakspace  {}$I_{\!R}$ (teal) is provably smaller, concentrating samples where path improvement is possible (teal dots).\relax }}{5}{figure.caption.8}\protected@file@percent }
\newlabel{fig:sampling_concept}{{3}{5}{Euclidean vs.\ Riemannian informed sets. The Euclidean set~$\IE $ (orange dashed) includes high-cost regions near obstacles, wasting samples (orange dots). The Riemannian set~$\IR $ (teal) is provably smaller, concentrating samples where path improvement is possible (teal dots).\relax }{figure.caption.8}{}}
\newlabel{fig:sampling_concept@cref}{{[figure][3][]3}{[1][4][]5}}

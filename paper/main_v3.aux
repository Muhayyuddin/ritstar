\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces CARM feedback loop. \textbf  {(a)}\nobreakspace  {}Collision points (red) cluster near obstacle boundaries during edge evaluation. \textbf  {(b)}\nobreakspace  {}KDE builds the adaptive cost field $s(x) = 1 + \alpha \,\hat  {f}(x)$, inflating traversal cost where collisions are dense. \textbf  {(c)}\nobreakspace  {}Updated metric tightens $I_{\!R}$ and steers sampling away from obstacles. The cycle repeats every $\Delta = 15$ iterations.\relax }}{8}{figure.caption.12}\protected@file@percent }
\newlabel{fig:carm_pipeline}{{6}{8}{CARM feedback loop. \textbf {(a)}~Collision points (red) cluster near obstacle boundaries during edge evaluation. \textbf {(b)}~KDE builds the adaptive cost field $s(x) = 1 + \alpha \,\hat {f}(x)$, inflating traversal cost where collisions are dense. \textbf {(c)}~Updated metric tightens $\IR $ and steers sampling away from obstacles. The cycle repeats every $\Delta = 15$ iterations.\relax }{figure.caption.12}{}}
\newlabel{fig:carm_pipeline@cref}{{[figure][6][]6}{[1][7][]8}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces CARM metric evolution over planning iterations. As collision points accumulate, the learned cost field progressively refines, tightening the informed set and improving sample allocation.\relax }}{8}{figure.caption.13}\protected@file@percent }

@njit(cache=True)
def _single_edge_sample_count(x: np.ndarray, y: np.ndarray,
                              n_checks: int, step_size: float) -> int:
    length_sq = 0.0
    for idx in range(x.shape[0]):
        diff = y[idx] - x[idx]
        length_sq += diff * diff
    length = np.sqrt(length_sq)
    if length < 1e-12:
        return 1
    if step_size > 0.0:
        n = int(np.ceil(length / step_size))
        if n < n_checks:
            n = n_checks
    else:
        if x.shape[0] <= 2:
            auto_step = 0.005
        elif x.shape[0] == 3:
            auto_step = 0.01
        else:
            auto_step = 0.02
        n = int(np.ceil(length / auto_step))
        if n < n_checks:
            n = n_checks
    return n + 1


@njit(cache=True)
def _single_edge_points(x: np.ndarray, y: np.ndarray,
                        n_checks: int, step_size: float) -> np.ndarray:
    n_pts = _single_edge_sample_count(x, y, n_checks, step_size)
    pts = np.empty((n_pts, x.shape[0]), dtype=np.float64)
    if n_pts == 1:
        for dim in range(x.shape[0]):
            pts[0, dim] = x[dim]
        return pts
    inv_n = 1.0 / (n_pts - 1)
    for i in range(n_pts):
        alpha = i * inv_n
        for dim in range(x.shape[0]):
            pts[i, dim] = x[dim] + alpha * (y[dim] - x[dim])
    return pts


@njit(cache=True)
def _edge_batch_sample_counts(starts: np.ndarray, ends: np.ndarray,
                              n_checks: int, step_size: float) -> np.ndarray:
    counts = np.empty(starts.shape[0], dtype=np.int64)
    for row in range(starts.shape[0]):
        counts[row] = _single_edge_sample_count(starts[row], ends[row], n_checks, step_size)
    return counts


@njit(cache=True)
def _edge_batch_offsets(counts: np.ndarray) -> Tuple[np.ndarray, int]:
    offsets = np.empty(counts.shape[0], dtype=np.int64)
    total = 0
    for row in range(counts.shape[0]):
        offsets[row] = total
        total += counts[row]
    return offsets, total


@njit(cache=True)
def _edge_batch_points(starts: np.ndarray, ends: np.ndarray,
                       counts: np.ndarray, offsets: np.ndarray,
                       total_points: int) -> np.ndarray:
    pts = np.empty((total_points, starts.shape[1]), dtype=np.float64)
    for row in range(starts.shape[0]):
        count = counts[row]
        base = offsets[row]
        if count == 1:
            for dim in range(starts.shape[1]):
                pts[base, dim] = starts[row, dim]
            continue
        inv_n = 1.0 / (count - 1)
        for step in range(count):
            alpha = step * inv_n
            out_idx = base + step
            for dim in range(starts.shape[1]):
                pts[out_idx, dim] = starts[row, dim] + alpha * (ends[row, dim] - starts[row, dim])
    return pts


@njit(cache=True)
def _reduce_edge_batch_results(point_free: np.ndarray,
                               counts: np.ndarray,
                               offsets: np.ndarray) -> Tuple[np.ndarray, np.ndarray]:
    free_edges = np.ones(counts.shape[0], dtype=np.bool_)
    first_hit = -np.ones(counts.shape[0], dtype=np.int64)
    for row in range(counts.shape[0]):
        start = offsets[row]
        end = start + counts[row]
        for idx in range(start, end):
            if not point_free[idx]:
                free_edges[row] = False
                first_hit[row] = idx
                break
    return free_edges, first_hit


@njit(cache=True)
def _squared_distances(points: np.ndarray, query: np.ndarray) -> np.ndarray:
    out = np.empty(points.shape[0], dtype=np.float64)
    for row in range(points.shape[0]):
        dist = 0.0
        for dim in range(points.shape[1]):
            delta = points[row, dim] - query[dim]
            dist += delta * delta
        out[row] = dist
    return out


def _transform_points(points: np.ndarray, scale: Optional[np.ndarray]) -> np.ndarray:
    if scale is None:
        return np.asarray(points, dtype=float)
    return np.asarray(points, dtype=float) * scale


def _transform_point(point: np.ndarray, scale: Optional[np.ndarray]) -> np.ndarray:
    if scale is None:
        return np.asarray(point, dtype=float)
    return np.asarray(point, dtype=float) * scale


class IncrementalKDTree:
    """Exact KD-tree queries with append-only buffering between rebuilds."""

    def __init__(self,
                 dim: int,
                 scale: Optional[np.ndarray] = None,
                 rebuild_growth: float = 0.2,
                 min_buffer: int = 16):
        self.dim = dim
        self.scale = None if scale is None else np.asarray(scale, dtype=float)
        self.rebuild_growth = float(rebuild_growth)
        self.min_buffer = int(max(1, min_buffer))
        self.clear()

    def clear(self) -> None:
        self._tree: Optional[KDTree] = None
        self._base_points = np.empty((0, self.dim), dtype=float)
        self._buffer_points = np.empty((0, self.dim), dtype=float)
        self._size = 0

    def rebuild(self, points: np.ndarray) -> None:
        transformed = _transform_points(points, self.scale)
        self._base_points = transformed
        self._buffer_points = np.empty((0, self.dim), dtype=float)
        self._tree = KDTree(transformed) if len(transformed) else None
        self._size = len(transformed)

    def append(self, points: np.ndarray) -> bool:
        if len(points) == 0:
            return False
        transformed = _transform_points(points, self.scale)
        if len(self._buffer_points) == 0:
            self._buffer_points = transformed
        else:
            self._buffer_points = np.vstack([self._buffer_points, transformed])
        self._size += len(transformed)
        base_n = max(len(self._base_points), 1)
        rebuild_limit = max(self.min_buffer, int(np.ceil(base_n * self.rebuild_growth)))
        return len(self._buffer_points) >= rebuild_limit

    def query_ball_point(self, point: np.ndarray, radius: float) -> List[int]:
        query = _transform_point(point, self.scale)
        idxs: List[int] = []
        if self._tree is not None:
            idxs.extend(self._tree.query_ball_point(query, radius))
        if len(self._buffer_points):
            buffer_d2 = _squared_distances(self._buffer_points, query)
            matches = np.where(buffer_d2 <= radius * radius)[0]
            if len(matches):
                idxs.extend((len(self._base_points) + matches).tolist())
        return idxs

    def query(self, point: np.ndarray) -> Tuple[float, int]:
        query = _transform_point(point, self.scale)
        best_dist = np.inf
        best_idx = -1
        if self._tree is not None:
            dist, idx = self._tree.query(query)
            best_dist = float(dist)
            best_idx = int(idx)
        if len(self._buffer_points):
            buffer_d2 = _squared_distances(self._buffer_points, query)
            local_idx = int(np.argmin(buffer_d2))
            local_dist = float(np.sqrt(buffer_d2[local_idx]))
            if local_dist < best_dist:
                best_dist = local_dist
                best_idx = len(self._base_points) + local_idx
        return best_dist, best_idx


def limit_neighbour_indices(vertices: List['Node'],
                            idxs: List[int],
                            sample: np.ndarray,
                            max_neighbours: int) -> List[int]:
    """Return the nearest neighbour indices to ``sample`` in original space."""
    if len(idxs) <= max_neighbours:
        return idxs
    points = np.empty((len(idxs), sample.shape[0]), dtype=float)
    for row, idx in enumerate(idxs):
        points[row] = vertices[idx].x
    dists = _squared_distances(points, sample)
    keep = np.argpartition(dists, max_neighbours - 1)[:max_neighbours]
    keep = keep[np.argsort(dists[keep])]
    return [idxs[int(row)] for row in keep]


def _batch_rect_collision_checker(rects, bounds):
    lo = np.array([b[0] for b in bounds], dtype=float)
    hi = np.array([b[1] for b in bounds], dtype=float)
    rect_lo = np.array([r[0] for r in rects], dtype=float)
    rect_hi = np.array([r[1] for r in rects], dtype=float)

    def batch_eval(points: np.ndarray) -> np.ndarray:
        pts = np.asarray(points, dtype=float)
        in_bounds = np.all((pts >= lo) & (pts <= hi), axis=1)
        inside = np.zeros(len(pts), dtype=bool)
        for r_lo, r_hi in zip(rect_lo, rect_hi):
            inside |= np.all((pts >= r_lo) & (pts <= r_hi), axis=1)
        return in_bounds & ~inside

    return batch_eval


def _batch_box_collision_checker(obs_list, bounds):
    lo = np.array([b[0] for b in bounds], dtype=float)
    hi = np.array([b[1] for b in bounds], dtype=float)
    box_lo = np.array([r[0] for r in obs_list], dtype=float)
    box_hi = np.array([r[1] for r in obs_list], dtype=float)

    def batch_eval(points: np.ndarray) -> np.ndarray:
        pts = np.asarray(points, dtype=float)
        in_bounds = np.all((pts >= lo) & (pts <= hi), axis=1)
        inside = np.zeros(len(pts), dtype=bool)
        for b_lo, b_hi in zip(box_lo, box_hi):
            inside |= np.all((pts >= b_lo) & (pts <= b_hi), axis=1)
        return in_bounds & ~inside

    return batch_eval


def _batch_ball_collision_checker(centres: np.ndarray,
                                  radii: np.ndarray,
                                  bounds) -> Callable[[np.ndarray], np.ndarray]:
    lo = np.array([b[0] for b in bounds], dtype=float)
    hi = np.array([b[1] for b in bounds], dtype=float)
    centres = np.asarray(centres, dtype=float)
    radii_sq = np.asarray(radii, dtype=float) ** 2

    def batch_eval(points: np.ndarray) -> np.ndarray:
        pts = np.asarray(points, dtype=float)
        in_bounds = np.all((pts >= lo) & (pts <= hi), axis=1)
        diff = pts[:, None, :] - centres[None, :, :]
        d2 = np.sum(diff * diff, axis=2)
        inside = np.any(d2 <= radii_sq[None, :], axis=1)
        return in_bounds & ~inside

    return batch_eval


def resolve_collision_batch_evaluator(collision_free: Callable,
                                      bounds: Optional[list] = None) -> Optional[Callable[[np.ndarray], np.ndarray]]:
    """Best-effort vectorized collision checker for common analytic environments."""
    batch_eval = getattr(collision_free, "batch_eval", None)
    if callable(batch_eval):
        return batch_eval
    if getattr(collision_free, "_batch_eval_unavailable", False):
        return None
    if bounds is None:
        return None
    try:
        nonlocals = inspect.getclosurevars(collision_free).nonlocals
    except Exception:
        setattr(collision_free, "_batch_eval_unavailable", True)
        return None

    batch_eval = None
    if "rects" in nonlocals:
        batch_eval = _batch_rect_collision_checker(nonlocals["rects"], bounds)
    elif "obs_list" in nonlocals:
        batch_eval = _batch_box_collision_checker(nonlocals["obs_list"], bounds)
    elif "circles" in nonlocals:
        circles = nonlocals["circles"]
        centres = np.array([c for c, _ in circles], dtype=float)
        radii = np.array([r for _, r in circles], dtype=float)
        batch_eval = _batch_ball_collision_checker(centres, radii, bounds)
    elif "sphere_centres" in nonlocals:
        radius = None
        if "r_obs" in nonlocals:
            radius = float(nonlocals["r_obs"])
        elif "obs_r" in nonlocals:
            radius = float(nonlocals["obs_r"])
        if radius is not None:
            centres = np.asarray(nonlocals["sphere_centres"], dtype=float)
            radii = np.full(len(centres), radius, dtype=float)
            batch_eval = _batch_ball_collision_checker(centres, radii, bounds)

    if batch_eval is None:
        setattr(collision_free, "_batch_eval_unavailable", True)
        return None
    setattr(collision_free, "batch_eval", batch_eval)
    return batch_eval


def batch_check_edges_collision(starts: np.ndarray,
                                ends: np.ndarray,
                                collision_free: Callable,
                                bounds: Optional[list] = None,
                                n_checks: int = 5,
                                step_size: float = 0.0,
                                want_feedback: bool = False) -> Tuple[np.ndarray, List[Optional[np.ndarray]]]:
    """Check multiple straight-line edges exactly, using a vectorized point test when available."""
    n_edges = len(starts)
    if n_edges == 0:
        return np.empty(0, dtype=bool), []

    batch_eval = resolve_collision_batch_evaluator(collision_free, bounds=bounds)
    if batch_eval is None:
        results = np.empty(n_edges, dtype=bool)
        feedback: List[Optional[np.ndarray]] = [None] * n_edges
        for idx in range(n_edges):
            if want_feedback:
                results[idx], feedback[idx] = check_edge_collision_with_feedback(
                    starts[idx], ends[idx], collision_free,
                    n_checks=n_checks, step_size=step_size)
            else:
                results[idx] = check_edge_collision(
                    starts[idx], ends[idx], collision_free,
                    n_checks=n_checks, step_size=step_size)
        return results, feedback

    starts = np.asarray(starts, dtype=float)
    ends = np.asarray(ends, dtype=float)
    counts = _edge_batch_sample_counts(starts, ends, n_checks, step_size)
    offsets, total_points = _edge_batch_offsets(counts)
    pts = _edge_batch_points(starts, ends, counts, offsets, total_points)
    point_free = np.asarray(batch_eval(pts), dtype=bool)
    free_edges, first_hit = _reduce_edge_batch_results(point_free, counts, offsets)
    feedback = [None] * n_edges
    if want_feedback:
        for idx, point_idx in enumerate(first_hit):
            if point_idx >= 0:
                feedback[idx] = pts[int(point_idx)].copy()
    return free_edges, feedback


